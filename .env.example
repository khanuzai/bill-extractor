# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Anthropic API (LLM extraction)
ANTHROPIC_API_KEY=

# Extraction model settings (optional; these are the defaults)
EXTRACTION_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max. Leave empty for models without it.
EXTRACTION_EFFORT=low
# Sampling temperature. Only sent to models that accept it (e.g. claude-haiku-4-5,
# claude-sonnet-4-6); for other models, such as claude-opus-5-5, it is ignored with a
# warning.
EXTRACTION_TEMPERATURE=

# PostgreSQL + pgvector (read by docker-compose.yml and the app)
POSTGRES_USER=bills
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bills
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
